{
  "name": "workpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:push": "node --env-file=.env.local scripts/db.mjs push",
    "db:test": "node --env-file=.env.local scripts/db.mjs test",
    "test:e2e": "node --env-file=.env.local e2e/run.mjs",
    "test:ai": "node --env-file=.env.local --experimental-transform-types --no-warnings e2e/assistant-eval.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright-core": "^1.64.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
