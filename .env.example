# Copy to .env.local and fill in. Never commit real values.

# From Supabase: Project Settings > API. Safe to expose to the browser, because
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only used by `npm run db:push`, `npm run db:test` and `npm run test:e2e`. It has
# full database access: keep it out of application code, don't set it on your host,
# and never give it a NEXT_PUBLIC_ prefix.
# Use the session pooler string if your network has no IPv6.
SUPABASE_DB_URL=

# Server-side only, for AI task extraction and the assistant. Without these the
# review form still works and you fill it in yourself, but the assistant can't
# answer. Never give them a NEXT_PUBLIC_ prefix.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Optional. The IANA time zone that decides what "today" means, for example
# Africa/Tunis. Defaults to the server's own zone, so set it when hosting.
WORKPILOT_TIME_ZONE=
